{
    "name": "grimmory-obsidian-plugin",
    "version": "1.0.1",
    "description": "Obsidian's plugin to connect to Grimmory",
    "private": true,
    "type": "commonjs",
    "main": "main.js",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "esbuild": "^0.28.2",
        "obsidian": "^1.13.1",
        "prettier": "^3.9.6",
        "tslib": "^2.8.1",
        "typescript": "^7.0.2"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    },
}

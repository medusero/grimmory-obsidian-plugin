{
    "name": "grimmory-obsidian-plugin",
    "version": "1.0.2",
    "description": "Obsidian's plugin to connect to Grimmory",
    "private": true,
    "type": "module",
    "main": "main.js",
    "scripts": {
        "test": "node --test 'test/**/*.test.ts'",
        "dev": "node esbuild.config.mjs",
        "typecheck": "tsc && tsc -p test",
        "build": "node esbuild.config.mjs production",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint"
    },
    "devDependencies": {
        "@types/node": "^24.19.2",
        "esbuild": "^0.28.2",
        "eslint": "^9.39.5",
        "eslint-plugin-obsidianmd": "^0.4.2",
        "obsidian": "^1.14.4",
        "prettier": "^3.9.10",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2"
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}

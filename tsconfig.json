{
    "compilerOptions": {
        "strict": true,
        "module": "ESNext",
        "target": "es2018",
        "lib": ["DOM", "ES2018"],
        "moduleResolution": "bundler",
        "isolatedModules": true,
        "noEmit": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true,
        "allowImportingTsExtensions": true,
        "erasableSyntaxOnly": true
    },
    "include": ["src/**/*.ts"]
}
